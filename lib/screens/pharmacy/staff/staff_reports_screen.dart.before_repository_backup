import 'package:cloud_firestore/cloud_firestore.dart';
import 'package:firebase_auth/firebase_auth.dart';
import 'package:flutter/material.dart';

import '../../../core/localization/app_localizations.dart';
import '../../../models/sale_model.dart';

class StaffReportsScreen extends StatefulWidget {
  const StaffReportsScreen({
    super.key,
  });

  @override
  State<StaffReportsScreen> createState() => _StaffReportsScreenState();
}

class _StaffReportsScreenState extends State<StaffReportsScreen> {
  final FirebaseFirestore _firestore = FirebaseFirestore.instance;
  final FirebaseAuth _auth = FirebaseAuth.instance;

  List<SaleModel> _allSales = [];
  List<SaleModel> _visibleSales = [];

  bool _loading = true;

  String _period = 'today';

  DateTime? _customStart;
  DateTime? _customEnd;

  String _t(
    AppLocalizations l10n,
    String english,
    String swahili,
  ) {
    return l10n.isSwahili ? swahili : english;
  }

  @override
  void initState() {
    super.initState();
    _loadMySales();
  }

  Future<void> _loadMySales() async {
    try {
      final user = _auth.currentUser;

      if (user == null) {
        throw Exception('User is not logged in.');
      }

      final snapshot = await _firestore
          .collection('sales')
          .where('staffId', isEqualTo: user.uid)
          .get();

      final sales = snapshot.docs
          .map(
            (document) => SaleModel.fromFirestore(document),
          )
          .toList();

      sales.sort(
        (a, b) {
          final aDate = a.createdAt;
          final bDate = b.createdAt;

          if (aDate == null && bDate == null) {
            return 0;
          }

          if (aDate == null) {
            return 1;
          }

          if (bDate == null) {
            return -1;
          }

          return bDate.compareTo(aDate);
        },
      );

      if (!mounted) {
        return;
      }

      setState(() {
        _allSales = sales;
        _loading = false;
      });

      _applyPeriod();
    } catch (e) {
      if (!mounted) {
        return;
      }

      setState(() {
        _loading = false;
      });

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            _t(
              AppLocalizations.of(context),
              'Failed to load your sales: ${_cleanError(e)}',
              'Imeshindikana kupakia mauzo yako: ${_cleanError(e)}',
            ),
          ),
        ),
      );
    }
  }

  void _applyPeriod() {
    final now = DateTime.now();

    DateTime start;
    DateTime end;

    if (_period == 'today') {
      start = DateTime(
        now.year,
        now.month,
        now.day,
      );

      end = DateTime(
        now.year,
        now.month,
        now.day,
        23,
        59,
        59,
      );
    } else if (_period == 'week') {
      final today = DateTime(
        now.year,
        now.month,
        now.day,
      );

      start = today.subtract(
        Duration(days: today.weekday - 1),
      );

      end = DateTime(
        today.year,
        today.month,
        today.day,
        23,
        59,
        59,
      );
    } else if (_period == 'month') {
      start = DateTime(
        now.year,
        now.month,
        1,
      );

      end = DateTime(
        now.year,
        now.month + 1,
        0,
        23,
        59,
        59,
      );
    } else {
      if (_customStart == null || _customEnd == null) {
        setState(() {
          _visibleSales = [];
        });
        return;
      }

      start = DateTime(
        _customStart!.year,
        _customStart!.month,
        _customStart!.day,
      );

      end = DateTime(
        _customEnd!.year,
        _customEnd!.month,
        _customEnd!.day,
        23,
        59,
        59,
      );
    }

    final filtered = _allSales.where((sale) {
      final date = sale.createdAt;

      if (date == null) {
        return false;
      }

      return !date.isBefore(start) &&
          !date.isAfter(end);
    }).toList();

    if (!mounted) {
      return;
    }

    setState(() {
      _visibleSales = filtered;
    });
  }

  Future<void> _selectCustomPeriod() async {
    final now = DateTime.now();

    final picked = await showDateRangePicker(
      context: context,
      firstDate: DateTime(
        now.year - 5,
        1,
        1,
      ),
      lastDate: now,
      initialDateRange: _customStart != null &&
              _customEnd != null
          ? DateTimeRange(
              start: _customStart!,
              end: _customEnd!,
            )
          : DateTimeRange(
              start: DateTime(
                now.year,
                now.month,
                now.day,
              ),
              end: now,
            ),
    );

    if (picked == null) {
      return;
    }

    setState(() {
      _period = 'custom';
      _customStart = picked.start;
      _customEnd = picked.end;
    });

    _applyPeriod();
  }

  double get _totalSales {
    return _visibleSales.fold<double>(
      0,
      (total, sale) => total + sale.totalAmount,
    );
  }

  double get _totalProfit {
    return _visibleSales.fold<double>(
      0,
      (total, sale) => total + sale.profit,
    );
  }

  int get _totalItems {
    return _visibleSales.fold<int>(
      0,
      (total, sale) => total + sale.quantity,
    );
  }

  String _formatCurrency(double value) {
    return 'TSh ${value.toStringAsFixed(0)}';
  }

  String _formatDate(DateTime? date) {
    if (date == null) {
      return '-';
    }

    return '${date.day.toString().padLeft(2, '0')}/'
        '${date.month.toString().padLeft(2, '0')}/'
        '${date.year}';
  }

  String _formatTime(DateTime? date) {
    if (date == null) {
      return '-';
    }

    return '${date.hour.toString().padLeft(2, '0')}:'
        '${date.minute.toString().padLeft(2, '0')}';
  }

  String _cleanError(Object error) {
    final message = error.toString();

    if (message.startsWith('Exception: ')) {
      return message.replaceFirst(
        'Exception: ',
        '',
      );
    }

    return message;
  }

