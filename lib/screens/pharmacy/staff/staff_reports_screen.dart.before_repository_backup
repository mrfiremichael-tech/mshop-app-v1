              ],
            ),
            const SizedBox(height: 12),
            Row(
              children: [
                Expanded(
                  child: Text(
                    'Qty: ${sale.quantity}',
                    style: const TextStyle(
                      fontSize: 12,
                    ),
                  ),
                ),
                Expanded(
                  child: Text(
                    'Profit: ${_formatCurrency(sale.profit)}',
                    style: const TextStyle(
                      fontSize: 12,
                    ),
                  ),
                ),
              ],
            ),
            const SizedBox(height: 6),
            Row(
              children: [
                Expanded(
                  child: Text(
                    'Customer: ${sale.customerName.isEmpty ? 'Walk-in Customer' : sale.customerName}',
                    style: TextStyle(
                      fontSize: 12,
                      color: Theme.of(context)
                          .colorScheme
                          .onSurfaceVariant,
                    ),
                  ),
                ),
                Text(
                  '${_formatDate(sale.createdAt)} ${_formatTime(sale.createdAt)}',
                  style: TextStyle(
                    fontSize: 11,
                    color: Theme.of(context)
                        .colorScheme
                        .onSurfaceVariant,
                  ),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }

  String _periodLabel(
    AppLocalizations l10n,
  ) {
    if (_period == 'today') {
      return _t(l10n, 'Today', 'Leo');
    }

    if (_period == 'week') {
      return _t(l10n, 'This Week', 'Wiki Hii');
    }

    if (_period == 'month') {
      return _t(l10n, 'This Month', 'Mwezi Huu');
    }

    if (_customStart != null &&
        _customEnd != null) {
      return '${_formatDate(_customStart)} - '
          '${_formatDate(_customEnd)}';
    }

    return _t(
      l10n,
      'Custom Period',
      'Kipindi Maalum',
    );
  }

  @override
  Widget build(BuildContext context) {
