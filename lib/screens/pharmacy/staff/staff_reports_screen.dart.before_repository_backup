  Widget _periodButton({
    required String value,
    required String title,
  }) {
    final selected = _period == value;

    return ChoiceChip(
      label: Text(title),
      selected: selected,
      onSelected: (_) {
        setState(() {
          _period = value;
        });

        _applyPeriod();
      },
    );
  }

